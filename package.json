  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "acceptance:runtime": "node scripts/runtime-acceptance/run.mjs --mode all",
    "acceptance:runtime:packaged": "node scripts/runtime-acceptance/run.mjs --mode packaged",
    "acceptance:runtime:platform": "node scripts/runtime-acceptance/run.mjs --mode platform",
    "acceptance:runtime:source": "node scripts/runtime-acceptance/run.mjs --mode source",
    "acceptance:runtime:static": "node scripts/runtime-acceptance/run.mjs --mode static",
    "build": "pnpm run prebuild && node scripts/marshal-build-release.cjs && pnpm run electron:build",
    "build:baileys-stage0": "node scripts/build-baileys-stage0.mjs",
    "build:vite": "vite build",
    "build:whatsapp-sidecar": "node scripts/build-whatsapp-sidecar.mjs",
    "create:runtime-extension": "node scripts/create-marshal-runtime-extension.mjs",
    "dev": "vite",
    "dev:gateway-mock": "pnpm run prebuild && vite build && node scripts/marshal-launch-gateway-mock.mjs",
    "electron:build": "pnpm run prebuild && electron-builder",
    "electron:debug": "pnpm run prebuild && vite build && node scripts/marshal-launch-electron.cjs --remote-debugging-port=9222",
    "electron:dev": "pnpm run prebuild && vite build && node scripts/marshal-launch-electron.cjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:icons": "node scripts/marshal-generate-badge-icons.mjs",
    "install:skills": "node scripts/marshal-install-skills.mjs",
    "lint": "oxlint --deny-warnings --type-aware --type-check",
    "lint:files": "oxlint --deny-warnings --type-aware --type-check",
    "marshal": "node scripts/marshal-cli.mjs",
    "pnpm:devPreinstall": "node scripts/marshal-preinstall.mjs",
    "postinstall": "node scripts/marshal-postinstall.mjs",
    "pre-commit": "lint-staged --allow-empty --concurrent 1",
    "prebuild": "pnpm run verify:marshal-runtime && pnpm run prebuild:skills && node scripts/marshal-prepare-bundled-node.mjs && pnpm run build:whatsapp-sidecar",
    "prebuild:skills": "node scripts/marshal-initialize-bundled-skills.mjs",
    "prepare": "husky",
    "prepare:agentic-browser-automation-extension": "node scripts/prepare-agentic-browser-automation-extension.mjs",
    "prepare:agentic-browser-extension": "node scripts/prepare-agentic-browser-extension.mjs",
    "prepare:agentic-debugger-extension": "node scripts/prepare-agentic-debugger-extension.mjs",
    "prepare:marshal-runtime": "node scripts/prepare-marshal-runtime.mjs",
    "preview": "vite preview",
    "probe:baileys-stage0": "node dist-baileys-stage0/baileys-stage0-probe.mjs",
    "probe:whatsapp-sidecar": "node dist-whatsapp-sidecar/whatsapp-sidecar-probe.mjs",
    "test": "vitest run --project unit --project node --project browser",
    "test:baileys-stage0": "pnpm run build:baileys-stage0 && vitest run --project node electron/baileys-stage0/baileys-stage0.test.ts && node --test scripts/electron-builder-afterpack.test.cjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:file": "playwright test --retries 0",
    "test:e2e:real": "node e2e-real/marshal-runner.mjs",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "test:python": "python3 -m unittest discover -s skills/marshal-review-dashboard/scripts -p \"test_*.py\" && python3 -m unittest discover -s skills/marshal-code-review/scripts -p \"test_*.py\"",
    "test:scripts": "node --test scripts/*.test.cjs scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:whatsapp-sidecar": "pnpm run build:whatsapp-sidecar && vitest run --project node electron/relay/providers/whatsapp/sidecar electron/relay/providers/whatsapp/connection-controller.test.ts && node --test scripts/electron-builder-afterpack.test.cjs",
    "tools:test": "vitest run --project tools",
    "tools:typecheck": "tsc -p tools/marshal-acp/tsconfig.json --noEmit && tsc -p tools/review-queue/tsconfig.marshal.json --noEmit",
    "typecheck": "tsc --noEmit",
    "verify:agentic-browser-automation-extension": "node scripts/prepare-agentic-browser-automation-extension.mjs --verify --installed",
    "verify:agentic-browser-extension": "node scripts/prepare-agentic-browser-extension.mjs --verify --installed",
    "verify:agentic-debugger-extension": "node scripts/prepare-agentic-debugger-extension.mjs --verify --installed",
    "verify:brand": "node scripts/verify-brand.mjs",
    "verify:fuses": "node scripts/marshal-verify-fuses.cjs",
    "verify:marshal-runtime": "node scripts/prepare-marshal-runtime.mjs --verify --installed && pnpm run verify:agentic-debugger-extension && pnpm run verify:agentic-browser-extension && pnpm run verify:agentic-browser-automation-extension",
    "verify:no-lolbin": "node scripts/marshal-verify-no-lolbin.cjs",
    "verify:nsis-install-path": "node --test scripts/nsis-install-path.test.cjs",
    "verify:rebrand": "node scripts/verify-rebrand.mjs",
    "verify:state-root": "node scripts/verify-marshal-state-root.mjs"
  },
